# Supabase Configuration for ResoVault
# Obtain your project credentials from:
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Supabase Service Role Key (Server-side ONLY - used by scheduled cron jobs to write shared news)
# Found in: Supabase Project Settings -> API -> Project API Keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: AI Provider API Key for Bulk Link Auto-Categorization
# (Supports Gemini, Claude, or OpenAI)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# NewsData.io API Key for Scheduled News Ingestion (Server-side only)
# Register for free at: https://newsdata.io/
NEWSDATA_API_KEY=

# Secret token to protect the scheduled cron route from unauthorized hits
CRON_SECRET=

